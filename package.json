{
  "name": "sandra-suh-portfolio",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/site-sandra",
    "packages/site-personal"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/site-personal",
    "build": "npm run build --workspace=packages/site-personal",
    "preview": "npm run preview --workspace=packages/site-personal",
    "dev:sandra": "npm run dev --workspace=packages/site-sandra",
    "build:sandra": "npm run build --workspace=packages/site-sandra",
    "preview:sandra": "npm run preview --workspace=packages/site-sandra",
    "dev:personal": "npm run dev --workspace=packages/site-personal",
    "build:personal": "npm run build --workspace=packages/site-personal",
    "preview:personal": "npm run preview --workspace=packages/site-personal",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.0.1",
    "vitest": "4.1.11"
  }
}
